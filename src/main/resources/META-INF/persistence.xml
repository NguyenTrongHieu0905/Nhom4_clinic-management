<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="clinicPU">
        <class>vn.edu.clinic.server.entity.UserAccount</class>
        <class>vn.edu.clinic.server.entity.Patient</class>
        <class>vn.edu.clinic.server.entity.Appointment</class>
        <class>vn.edu.clinic.server.entity.Visit</class>
        <class>vn.edu.clinic.server.entity.LabTest</class>
        <class>vn.edu.clinic.server.entity.Medicine</class>
        <class>vn.edu.clinic.server.entity.Prescription</class>
        <class>vn.edu.clinic.server.entity.PrescriptionItem</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:file:./data/clinicdb-v2"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
